<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunchuan.medical.mapper.ConsultMessageMapper">
    
    <resultMap id="messageMap" type="ConsultMessage">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="reply" column="reply"/>
        <result property="type" column="type"/>
        <result property="status" column="status"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>
    
    <insert id="insert">
        INSERT INTO consult_message (
            id, user_id, content, reply, type,
            status, create_time, update_time
        ) VALUES (
            #{id}, #{userId}, #{content}, #{reply}, #{type},
            #{status}, #{createTime}, #{updateTime}
        )
    </insert>
    
    <select id="selectByUserId" resultMap="messageMap">
        SELECT * FROM consult_message 
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>
</mapper> 