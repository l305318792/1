<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunchuan.medical.mapper.ConsultationMapper">
    
    <resultMap id="BaseResultMap" type="com.yunchuan.medical.entity.Consultation">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="doctor_id" property="doctorId"/>
        <result column="department_id" property="departmentId"/>
        <result column="appointment_id" property="appointmentId"/>
        <result column="symptoms" property="symptoms"/>
        <result column="diagnosis" property="diagnosis"/>
        <result column="treatment" property="treatment"/>
        <result column="status" property="status"/>
        <result column="start_time" property="startTime"/>
        <result column="end_time" property="endTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, doctor_id, department_id, appointment_id, symptoms, diagnosis, treatment,
        status, start_time, end_time, create_time, update_time
    </sql>

    <insert id="insert" parameterType="com.yunchuan.medical.entity.Consultation">
        INSERT INTO consultation (
            id, user_id, doctor_id, department_id, appointment_id, symptoms, diagnosis, treatment,
            status, start_time, end_time, create_time, update_time
        ) VALUES (
            #{id}, #{userId}, #{doctorId}, #{departmentId}, #{appointmentId}, #{symptoms}, #{diagnosis}, #{treatment},
            #{status}, #{startTime}, #{endTime}, #{createTime}, #{updateTime}
        )
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM consultation
        WHERE id = #{id}
    </select>

    <select id="selectList" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM consultation
        ORDER BY create_time DESC
    </select>

    <!-- 自定义查询方法 -->
    <select id="selectByDoctorId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM consultation
        WHERE doctor_id = #{doctorId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM consultation
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM consultation
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>
</mapper> 