<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yunchuan.medical.mapper.RefundRecordMapper">

    <resultMap id="BaseResultMap" type="com.yunchuan.medical.entity.RefundRecord">
        <id column="id" property="id"/>
        <result column="payment_id" property="paymentId"/>
        <result column="user_id" property="userId"/>
        <result column="amount" property="amount"/>
        <result column="business_type" property="businessType"/>
        <result column="business_id" property="businessId"/>
        <result column="reason" property="reason"/>
        <result column="status" property="status"/>
        <result column="reject_reason" property="rejectReason"/>
        <result column="operator_id" property="operatorId"/>
        <result column="refund_time" property="refundTime"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, payment_id, user_id, amount, business_type, business_id,
        reason, status, reject_reason, operator_id, refund_time,
        create_time, update_time
    </sql>

    <!-- 根据用户ID查询退款记录 -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM refund_record
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <!-- 根据状态查询退款记录 -->
    <select id="selectByStatus" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM refund_record
        WHERE status = #{status}
        ORDER BY create_time DESC
    </select>

    <!-- 根据时间范围查询退款记录 -->
    <select id="selectByTimeRange" resultMap="BaseResultMap">
        SELECT 
        <include refid="Base_Column_List"/>
        FROM refund_record
        WHERE create_time BETWEEN #{startTime} AND #{endTime}
        ORDER BY create_time DESC
    </select>

    <!-- 分页查询 -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM refund_record
        <where>
            <if test="ew != null">
                <if test="ew.sqlSegment != null and ew.sqlSegment != ''">
                    ${ew.sqlSegment}
                </if>
            </if>
        </where>
        ORDER BY create_time DESC
    </select>

    <!-- 统计总数 -->
    <select id="countRefundRecords" resultType="long">
        SELECT COUNT(*)
        FROM refund_record
        <where>
            1=1
        </where>
    </select>

</mapper> 